*.swp
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Simulation output written by the CLI. The checked-in figures under
# docs/images/ are regenerated by examples/generate_figures.py and are
# deliberately tracked, so they are re-included below.
*.png
*.pdf
*.svg
*.csv
*.json
!docs/images/*.png
!.github/**/*.json
